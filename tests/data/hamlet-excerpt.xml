    <body>
      <div type="act" n="1">
        <head>ACT 1 </head>
        <div type="scene" n="1">
          <head>Scene 1 </head>
          <stage xml:id="stg-0000" n="SD 1.1.0" type="entrance" who="#Barnardo_Ham #Francisco_Ham">Enter Barnardo and Francisco, two sentinels. </stage>
          <sp xml:id="sp-0001" who="#Barnardo_Ham">
            <speaker xml:id="spk-0001">BARNARDO </speaker>
            <p xml:id="p-0001">
              <lb xml:id="ftln-0001" n="1.1.1"/>Who's there? </p>
          </sp>
          <sp xml:id="sp-0002" who="#Francisco_Ham">
            <speaker xml:id="spk-0002">FRANCISCO </speaker>
            <l xml:id="ftln-0002" n="1.1.2">Nay, answer me. Stand and unfold yourself. </l>
          </sp>
          <sp xml:id="sp-0003" who="#Barnardo_Ham">
            <speaker xml:id="spk-0003">BARNARDO </speaker>
            <p xml:id="p-0003">
              <lb xml:id="ftln-0003" n="1.1.3"/>Long live the King! </p>
          </sp>
          <sp xml:id="sp-0008" who="#Francisco_Ham">
            <speaker xml:id="spk-0008">FRANCISCO </speaker>
            <l xml:id="ftln-0008" n="1.1.8">For this relief much thanks. 'Tis bitter cold, </l>
            <l xml:id="ftln-0009" n="1.1.9">And I am sick at heart. </l>
          </sp>
        </div>
      </div>
