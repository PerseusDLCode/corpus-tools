    <body>
      <div type="act" n="1">
        <head>ACT 1 </head>
        <div type="scene" n="1">
          <head>Scene 1 </head>
          <stage xml:id="stg-0000" n="SD 1.1.0" type="entrance" who="#WITCHES.1_Mac #WITCHES.2_Mac #WITCHES.3_Mac">
            <stage xml:id="snd-0000a" n="SD 1.1.0" type="sound" ana="thunder">Thunder </stage> and Lightning. Enter three Witches. </stage>
          <sp xml:id="sp-0001" who="#WITCHES.1_Mac">
            <speaker xml:id="spk-0001">FIRST WITCH </speaker>
            <l xml:id="ftln-0001" n="1.1.1">When shall we three meet again? </l>
            <l xml:id="ftln-0002" n="1.1.2">In thunder, lightning, or in rain? </l>
          </sp>
          <sp xml:id="sp-0006" who="#WITCHES.1_Mac">
            <speaker xml:id="spk-0006">FIRST WITCH </speaker>
            <l xml:id="ftln-0006" n="1.1.6" part="I">Where the place? </l>
          </sp>
          <sp xml:id="sp-0007" who="#WITCHES.2_Mac">
            <speaker xml:id="spk-0007">SECOND WITCH </speaker>
            <l xml:id="ftln-0007" n="1.1.7" part="F">Upon the heath. </l>
          </sp>
          <sp xml:id="sp-0009" who="#WITCHES.1_Mac">
            <speaker xml:id="spk-0009">FIRST WITCH </speaker>
            <p xml:id="p-0009">
              <lb xml:id="ftln-0009" n="1.1.9"/>I come, Graymalkin. </p>
          </sp>
        </div>
      </div>
